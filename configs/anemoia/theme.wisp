// anemoia's palette is fixed, not symlinked: the hud's coloured toggle fills
// (PEACH/SAGE) carry state, so a swapped palette would change what they mean

const FG      = #ffffffff;
const DIM     = #ff7a808b;
const CRUST   = #ff0f1219;   // bar/hud/osd ground; armpit_color must match
const SUNK    = #ff1c2733;   // progress track, separator
const ACT     = #ff2a2f3a;   // active tag, selected menu row
const URG     = #ffee3300;
const WARN    = #ffff5050;
const AMBER   = #ffffaa20;
const CHARGE  = #ff7fbf9f;
const ACCENT  = #ff84a7b3;   // progress fill

const SURFACE = #26ffffff;   // hud button rest, translucent over the wallpaper
const PEACH   = #ffe6b89c;   // gamma warm on
const SAGE    = #ff8fb3a3;   // dnd on
const TEAL    = #ff7fb0bb;   // .pop:pressed
const DARK    = #ff1a2530;   // text on a lit toggle

const LOCKBG  = #cc101418;
const LOCKED  = #ff101418;
const LOCKFG  = #ffa8d5cc;
const LOCKRING = #ff5f8a93;
const LOCKBAD = #ffd06878;
const LOCKCAPS = #ffe0c060;
const SCRIM   = #59000000;
const BLACK   = #ff000000;
const CLEAR   = #00000000;

const WALL    = "~/.local/share/wallpapers/anemoia.png";
